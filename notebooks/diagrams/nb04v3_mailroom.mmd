flowchart LR
    A["Agent writes a file"] --> R{{"CompositeBackend<br/>(the mail room)"}}
    R -->|"/memories/..."| ST[("Long term store")]
    R -->|"/docs/..."| D[("Folder on disk")]
    R -->|"anything else"| M[("Memory only<br/>(the default)")]
    class R orange
    class ST green
    class D blue
    class M soft

