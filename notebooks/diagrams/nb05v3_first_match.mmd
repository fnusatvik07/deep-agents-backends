flowchart TD
    REQ["Read /salaries/bands/engineering.md"] --> R1{{"Rule 1: allow reading<br/>/salaries/bands/**"}}
    R1 -->|"fits"| ALLOW["Allowed"]
    R1 -->|"does not fit"| R2{{"Rule 2: deny<br/>/salaries/**"}}
    R2 -->|"fits"| DENY["Denied"]
    R2 -->|"does not fit"| R3{{"Rules 3 and 4"}}
    R3 -->|"fits"| ACT["deny, or ask a human"]
    R3 -->|"nothing fits"| DEF["Allowed"]
    class ALLOW,DEF green
    class DENY bad
    class ACT orange

